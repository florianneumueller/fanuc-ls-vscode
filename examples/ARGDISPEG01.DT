[PROGRAM]
NAME = "AUTO_SEARCH"
ARGUMENT = '5'
[ARGUMENT]
V01 = "WIRE_SENSE":'1', "TOUCH_SENSE":'2'
V02 = "START_POS":'1', "END_POS":'2'
V03 = "X_PLUS":'1', "X_MINUS":'2', "Y_PLUS":'3', "Y_MINUS":'4', "X_PLUS_Y_PLUS":'5', "X_PLUS_Y_MINUS":'6', "X_MINUS_Y_MINUS":'7', "X_MINUS_Y_PLUS":'8', "X_PLUS_Z_PLUS":'9', "X_PLUS_Z_MINUS":'10', "X_MINUS_Z_PLUS":'11', "X_MINUS_Z_MINUS":'12', "Y_PLUS_Z_PLUS":'13', "Y_PLUS_Z_MINUS":'14', "Y_MINUS_Z_PLUS":'15', "Y_MINUS_Z_MINUS":'16'
N04 = "SEARCH_LENGTH"
N05 = "EDGE_HIGHT"
[ENDPROGRAM]