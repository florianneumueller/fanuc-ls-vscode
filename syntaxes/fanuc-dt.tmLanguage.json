{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FANUC Argument Wizard (ARGDISP)",
  "scopeName": "source.fanuc-dt",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#section"
    },
    {
      "include": "#headerKey"
    },
    {
      "include": "#argKey"
    },
    {
      "include": "#unknownKey"
    },
    {
      "include": "#value"
    }
  ],
  "repository": {
    "comment": {
      "begin": "\\{",
      "end": "\\}",
      "name": "comment.block.braces.fanuc-dt"
    },
    "section": {
      "match": "^\\s*(\\[)\\s*(PROGRAM|ARGUMENT|ENDPROGRAM)\\s*(\\])",
      "captures": {
        "0": {
          "name": "keyword.control.section.fanuc-dt"
        },
        "1": {
          "name": "punctuation.definition.section.fanuc-dt"
        },
        "3": {
          "name": "punctuation.definition.section.fanuc-dt"
        }
      }
    },
    "headerKey": {
      "match": "^\\s*(NAME|ARGUMENT)\\s*([=:])",
      "captures": {
        "1": {
          "name": "variable.other.property.fanuc-dt"
        },
        "2": {
          "name": "keyword.operator.assignment.fanuc-dt"
        }
      }
    },
    "argKey": {
      "match": "^\\s*(?:(N)|(S)|(V)|(W))(\\d+)\\s*(=)",
      "captures": {
        "1": {
          "name": "storage.type.number.fanuc-dt"
        },
        "2": {
          "name": "storage.type.string.fanuc-dt"
        },
        "3": {
          "name": "storage.type.enum.fanuc-dt"
        },
        "4": {
          "name": "storage.type.enum.fanuc-dt"
        },
        "5": {
          "name": "constant.numeric.argument-index.fanuc-dt"
        },
        "6": {
          "name": "keyword.operator.assignment.fanuc-dt"
        }
      }
    },
    "unknownKey": {
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
      "captures": {
        "1": {
          "name": "invalid.illegal.key.fanuc-dt"
        },
        "2": {
          "name": "keyword.operator.assignment.fanuc-dt"
        }
      }
    },
    "value": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "\"[^\"]*\"",
          "name": "string.quoted.double.fanuc-dt"
        },
        {
          "match": "'-?\\d+(?:\\.\\d+)?'",
          "name": "constant.numeric.fanuc-dt"
        },
        {
          "match": "'[^']*'",
          "name": "string.quoted.single.fanuc-dt"
        },
        {
          "match": "\\(\\s*(R|AR|SR)\\s*\\)",
          "captures": {
            "0": {
              "name": "variable.language.register.fanuc-dt"
            }
          }
        },
        {
          "match": ":",
          "name": "punctuation.separator.key-value.fanuc-dt"
        },
        {
          "match": ",",
          "name": "punctuation.separator.list.fanuc-dt"
        }
      ]
    }
  }
}
