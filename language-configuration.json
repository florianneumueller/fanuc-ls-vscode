{
  "comments": {
    "lineComment": "!"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "(\\$?[A-Za-z_][A-Za-z0-9_]*)|(\\d+(\\.\\d+)?)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*\\d+:\\s*(IF\\b(?!.*,\\s*(JMP|CALL|.*=)).*|FOR\\b.*|SELECT\\b.*|ELSE\\b.*)$",
    "decreaseIndentPattern": "^\\s*\\d+:\\s*(ENDIF|ENDFOR|ENDSELECT|ELSE)\\b"
  },
  "folding": {
    "markers": {
      "start": "^\\s*/(PROG|ATTR|APPL|MN|POS)\\b",
      "end": "^\\s*/END\\b"
    }
  }
}
