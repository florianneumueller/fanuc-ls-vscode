{
  "comments": {
    "blockComment": [
      "{",
      "}"
    ]
  },
  "brackets": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ],
    [
      "{",
      "}"
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*\\[\\s*PROGRAM\\s*\\]",
      "end": "^\\s*\\[\\s*ENDPROGRAM\\s*\\]"
    }
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_\\-]*|\\d+"
}
